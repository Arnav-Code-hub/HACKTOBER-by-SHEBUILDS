{
  "name": "@janmaang/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @janmaang/tokens build",
    "dev": "next dev --turbo -p 3000",
    "prebuild": "pnpm --filter @janmaang/tokens build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@janmaang/contracts": "workspace:*",
    "@janmaang/tokens": "workspace:*",
    "@janmaang/ui": "workspace:*",
    "@tanstack/react-query": "^5.59.16",
    "firebase": "^11.0.2",
    "maplibre-gl": "^4.7.1",
    "next": "^15.0.3",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@janmaang/config": "workspace:*",
    "@next/eslint-plugin-next": "15.5.25",
    "@playwright/test": "^1.48.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
