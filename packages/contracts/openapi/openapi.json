{
  "openapi": "3.1.0",
  "info": {
    "title": "JanMaang API",
    "description": "Civic demand-to-budget platform. A citizen reports a local need; AI structures it; identical reports cluster; the cluster is ranked, funded, executed and citizen-verified.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Current Profile",
        "operationId": "current_profile_api_v1_users_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/reports": {
      "post": {
        "tags": [
          "Reports"
        ],
        "summary": "Create",
        "operationId": "create_api_v1_reports_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Mine",
        "operationId": "mine_api_v1_reports_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "mine",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Mine"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/{report_id}": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Detail",
        "operationId": "detail_api_v1_reports__report_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Report Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/signature": {
      "post": {
        "tags": [
          "Media"
        ],
        "summary": "Signature",
        "operationId": "signature_api_v1_media_signature_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadAuthorization"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/media/complete": {
      "post": {
        "tags": [
          "Media"
        ],
        "summary": "Complete",
        "operationId": "complete_api_v1_media_complete_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadComplete"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "string",
        "enum": [
          "water",
          "roads",
          "lighting",
          "sanitation",
          "health",
          "education",
          "electricity",
          "transport",
          "other"
        ],
        "title": "Category"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MediaRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "thumbnail_url": {
            "type": "string",
            "title": "Thumbnail Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "url",
          "thumbnail_url"
        ],
        "title": "MediaRead"
      },
      "ProblemStatus": {
        "type": "string",
        "enum": [
          "reported",
          "verified",
          "rejected",
          "prioritised",
          "funded",
          "in_progress",
          "awaiting_verification",
          "citizen_verified"
        ],
        "title": "ProblemStatus",
        "description": "The agreed report lifecycle. Mirrored by the Flutter mapping in\napps/mobile/lib/features/report/data/report_dto.dart and documented in\ndocs/api/day1-frontend-contract.md \u2014 change all three together.\n\nVERIFIED means validated by the Panchayat. Citizen confirmation of a repair\nis CITIZEN_VERIFIED."
      },
      "ReportCreate": {
        "properties": {
          "transcript": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Transcript"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "summary": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Summary"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "location_label": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Location Label"
          },
          "channel": {
            "type": "string",
            "enum": [
              "text",
              "voice"
            ],
            "title": "Channel"
          },
          "media_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Media Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transcript",
          "title",
          "category",
          "severity",
          "summary",
          "latitude",
          "longitude",
          "location_label",
          "channel"
        ],
        "title": "ReportCreate"
      },
      "ReportList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReportRead"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ReportList"
      },
      "ReportRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "transcript": {
            "type": "string",
            "title": "Transcript"
          },
          "reporter_id": {
            "type": "string",
            "format": "uuid",
            "title": "Reporter Id"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "status": {
            "$ref": "#/components/schemas/ProblemStatus"
          },
          "status_changed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Status Changed At"
          },
          "ward": {
            "type": "string",
            "title": "Ward"
          },
          "district": {
            "type": "string",
            "title": "District"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "rejection_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rejection Reason"
          },
          "cluster_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cluster Id"
          },
          "is_demo": {
            "type": "boolean",
            "title": "Is Demo"
          },
          "media": {
            "items": {
              "$ref": "#/components/schemas/MediaRead"
            },
            "type": "array",
            "title": "Media"
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "title",
          "description",
          "transcript",
          "reporter_id",
          "category",
          "severity",
          "status",
          "status_changed_at",
          "ward",
          "district",
          "latitude",
          "longitude",
          "channel",
          "created_at",
          "updated_at",
          "rejection_reason",
          "cluster_id",
          "is_demo",
          "media"
        ],
        "title": "ReportRead"
      },
      "Role": {
        "type": "string",
        "enum": [
          "citizen",
          "student",
          "faculty",
          "institute",
          "panchayat",
          "department",
          "officer",
          "industry",
          "gov_admin",
          "super_admin"
        ],
        "title": "Role",
        "description": "Every role in JanMaang.\n\nCITIZEN is the mobile app's role and has no web dashboard; the other nine\nare web roles."
      },
      "Severity": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "Severity"
      },
      "UploadAuthorization": {
        "properties": {
          "upload_id": {
            "type": "string",
            "format": "uuid",
            "title": "Upload Id"
          },
          "upload_url": {
            "type": "string",
            "title": "Upload Url"
          },
          "parameters": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Parameters"
          }
        },
        "type": "object",
        "required": [
          "upload_id",
          "upload_url",
          "parameters"
        ],
        "title": "UploadAuthorization"
      },
      "UploadComplete": {
        "properties": {
          "upload_id": {
            "type": "string",
            "format": "uuid",
            "title": "Upload Id"
          },
          "public_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Public Id"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Version"
          },
          "signature": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$",
            "title": "Signature"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "upload_id",
          "public_id",
          "version",
          "signature"
        ],
        "title": "UploadComplete"
      },
      "UploadRequest": {
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ],
            "title": "Content Type"
          },
          "bytes": {
            "type": "integer",
            "maximum": 10485760.0,
            "exclusiveMinimum": 0.0,
            "title": "Bytes"
          },
          "kind": {
            "type": "string",
            "enum": [
              "report",
              "completion"
            ],
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "filename",
          "content_type",
          "bytes",
          "kind"
        ],
        "title": "UploadRequest"
      },
      "UserProfile": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "firebase_uid": {
            "type": "string",
            "title": "Firebase Uid"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "district_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "District Id"
          },
          "department_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department Id"
          },
          "institute_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Institute Id"
          },
          "organization_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organization Id"
          },
          "is_demo": {
            "type": "boolean",
            "title": "Is Demo"
          }
        },
        "type": "object",
        "required": [
          "id",
          "firebase_uid",
          "role",
          "display_name",
          "email",
          "district_id",
          "department_id",
          "institute_id",
          "organization_id",
          "is_demo"
        ],
        "title": "UserProfile"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
