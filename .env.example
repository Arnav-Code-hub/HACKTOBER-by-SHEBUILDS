# ─────────────────────────────────────────────────────────────────────────────
# Root .env — INFRASTRUCTURE ONLY.
#
# This file holds values docker-compose needs to wire services together:
# database credentials and host port mappings. It deliberately contains no
# API keys. Application secrets live in each service's own .env, so the web
# app can never be handed the LLM key.
#
#   cp .env.example .env      (make setup does this for every service)
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (used by the postgres container and composed into DATABASE_URL)
POSTGRES_USER=janmaang
POSTGRES_PASSWORD=janmaang
POSTGRES_DB=janmaang
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Host port mappings — change these if something else already owns the port.
API_PORT=8000
AI_PORT=8001
WEB_PORT=3000
