# JanMaang AI — internal service. Never exposed publicly; only services/api
# calls it. Every value here is a server-side secret.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Shared secret the API sends as X-Internal-Key. Must match services/api's
# AI_SERVICE_KEY. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=dev-internal-key-change-me

# LLM provider. The provider is abstracted in app/core/llm.py so swapping
# models is a config change, not a code change.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Embeddings for duplicate detection. Vectors are returned to the API, which
# owns the pgvector table — this service persists nothing.
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# Response cache. Classification of identical text should not be paid for twice.
REDIS_URL=redis://localhost:6379/1
CACHE_TTL_SECONDS=86400

# Cost guardrail. Refuses calls once the daily budget is exceeded, so a runaway
# loop cannot drain the account mid-hackathon.
DAILY_TOKEN_BUDGET=2000000
