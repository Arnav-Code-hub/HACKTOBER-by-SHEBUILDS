# JanMaang API — service-scoped secrets.
# Every value here is SERVER-SIDE. Nothing in this file may reach a browser
# bundle or an APK.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Overridden by docker-compose to point at the postgres/redis containers.
DATABASE_URL=postgresql+asyncpg://janmaang:janmaang@localhost:5432/janmaang
REDIS_URL=redis://localhost:6379/0

# Internal service-to-service call. The AI service is never exposed publicly.
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_KEY=dev-internal-key-change-me
AI_REQUEST_TIMEOUT_SECONDS=30

# Firebase — the API verifies client ID tokens and sends FCM pushes.
# Point this at a service-account JSON path, or paste the JSON into
# FIREBASE_CREDENTIALS_JSON in deployed environments. NEVER commit either.
FIREBASE_PROJECT_ID=janmaang-dev
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Object storage. Firebase Storage today; swap to any S3-compatible endpoint
# without touching callers — the files module hides the difference.
STORAGE_PROVIDER=firebase
STORAGE_BUCKET=janmaang-dev.appspot.com
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# Server-side maps key (geocoding). The client keys are separate and restricted.
MAPS_API_KEY=

# Signs internal session state. Generate with: openssl rand -hex 32
AUTH_SECRET=dev-only-not-a-real-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=60

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000
