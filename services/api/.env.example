# JanMaang API — service-scoped secrets.
# Every value here is SERVER-SIDE. Nothing in this file may reach a browser
# bundle or an APK.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL only. Supabase: use the session-pooler URL with this driver.
DATABASE_URL=postgresql+asyncpg://janmaang:janmaang@localhost:5432/janmaang
# Reset is off by default. Enable only for an explicitly designated demo DB.
SEED_RESET_ALLOWED=false
SEED_RESET_TARGETS=janmaang@localhost:5432/janmaang
# No REDIS_URL is needed. Legacy tools may explicitly configure it.

# Firebase — the API verifies client ID tokens and sends FCM pushes.
# Point this at a service-account JSON path, or paste the JSON into
# FIREBASE_CREDENTIALS_JSON in deployed environments. NEVER commit either.
FIREBASE_PROJECT_ID=janmaang-dev
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Server-side only. Missing provider credentials do not block Phase 0 health.
# Provider endpoints will validate their configuration when implemented.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=janmaang
# Signed preset: allowed_formats=jpg,jpeg,png,webp. File size is checked by
# the client, signature endpoint, and Admin metadata at completion (not preset).
# Disable incoming transformations, filename-based public IDs, and folder overrides.
CLOUDINARY_UPLOAD_PRESET=janmaang_signed
MEDIA_UPLOAD_TTL_SECONDS=900
GEMINI_API_KEY=
# Set an available model in your Gemini project when implementing Phase 7.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=8
# 0 = no thinking (Flash); models that require thinking need e.g. 128; -1 = model default.
GEMINI_THINKING_BUDGET=0

# Server-side maps key (geocoding). The client keys are separate and restricted.
MAPS_API_KEY=

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8080,http://localhost:8080
# Optional independent AI Council. Keep disabled until its quality gate is approved.
COUNCIL_ENABLED=false
COUNCIL_URL=
COUNCIL_SERVICE_KEY=
COUNCIL_ALLOW_SIMULATION=false
